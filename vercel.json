{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/Frontend/dashboard/index.html"
    },
    {
      "source": "/scanner",
      "destination": "/Frontend/index.html"
    },
    {
      "source": "/ar",
      "destination": "/Frontend/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/Frontend/dashboard/$1"
    },
    {
      "source": "/dashboard",
      "destination": "/Frontend/dashboard/index.html"
    },
    {
      "source": "/dashboard.css",
      "destination": "/Frontend/dashboard/dashboard.css"
    },
    {
      "source": "/dashboard.js",
      "destination": "/Frontend/dashboard/dashboard.js"
    },
    {
      "source": "/style.css",
      "destination": "/Frontend/style.css"
    },
    {
      "source": "/app.js",
      "destination": "/Frontend/app.js"
    },
    {
      "source": "/markers/(.*)",
      "destination": "/Frontend/markers/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/Frontend/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/Frontend/$1"
    }
  ]
}
